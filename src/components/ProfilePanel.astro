---
import { homeProfile, photoNotes } from "../data/home";
---
<section class="section developer-hero" aria-labelledby="profile-title">
  <div class="hero-copy">
    <div class="hero-profile">
      <img src={homeProfile.avatar} alt={homeProfile.avatarAlt} width="176" height="132" />
      <span class="eyebrow">PERSONAL FIELD NOTE / 01</span>
    </div>
    <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> {homeProfile.role} <span class="eyebrow-separator">/</span> DECSEVEN</p>
    <h1 id="profile-title">
      {homeProfile.headline.map((line) => <span>{line}</span>)}
    </h1>
    <p class="hero-bio">{homeProfile.bio}</p>
    <div class="hero-actions">
      <a class="action-link action-link--primary" href="/work/">看看我的作品 <span aria-hidden="true">↗</span></a>
      <a class="quiet-link" href="/writing/">从一篇文章开始 <span aria-hidden="true">→</span></a>
    </div>
  </div>
  <div class="hero-side">
    <section class="hero-photo" aria-labelledby="photo-title" data-photo-carousel data-photo-count={Math.min(photoNotes.length, 10)}>
      <div class="hero-photo__heading">
        <p class="eyebrow">PHOTO SWITCHER <span class="eyebrow-separator">/</span> 01</p>
        <span class="hero-photo__count">{String(Math.min(photoNotes.length, 10)).padStart(2, "0")} 张记录</span>
      </div>
      <h2 id="photo-title" class="sr-only">照片切换台</h2>
      <div class="photo-switcher">
        <div class="photo-switcher__stage">
          <span class="photo-switcher__mark photo-switcher__mark--top" aria-hidden="true">D7 / FIELD</span>
          <span class="photo-switcher__mark photo-switcher__mark--bottom" aria-hidden="true">KEEP LOOKING</span>
          <div class="photo-track">
          {photoNotes.slice(0, 10).map((photo, index) => (
            <figure class:list={["photo-note", index === 0 ? "is-current" : "is-hidden"]} data-photo-slide aria-hidden={index === 0 ? undefined : "true"}>
              <div class="photo-note__paper">
                <div class="photo-note__image"><img src={photo.src} alt={photo.alt} loading={index === 0 ? "eager" : "lazy"} /></div>
                <figcaption>
                  <span class="eyebrow">{photo.label}</span>
                  <p>{photo.caption}</p>
                </figcaption>
              </div>
            </figure>
          ))}
          </div>
          <button type="button" class="photo-switcher__trigger" data-photo-next title="切换到下一张照片" aria-label="切换到下一张照片">
            <span aria-hidden="true">↻</span>
            <span>换一张</span>
          </button>
        </div>
        <div class="photo-controls" data-photo-controls aria-label="照片轮播控制">
          <button type="button" class="photo-control" data-photo-prev title="上一张照片" aria-label="上一张照片">←</button>
          <span class="photo-counter" data-photo-counter>01 / {String(Math.min(photoNotes.length, 10)).padStart(2, "0")}</span>
          <span class="photo-controls__label">左滑切换</span>
          <button type="button" class="photo-control" data-photo-next title="下一张照片" aria-label="下一张照片">→</button>
        </div>
      </div>
    </section>
  </div>
</section>

<script>
  const carousel = document.querySelector("[data-photo-carousel]");
  const slides = carousel ? [...carousel.querySelectorAll("[data-photo-slide]")] : [];
  const controls = carousel?.querySelector("[data-photo-controls]");
  const counter = carousel?.querySelector("[data-photo-counter]");
  const previous = carousel?.querySelector("[data-photo-prev]");
  const nextButtons = carousel ? [...carousel.querySelectorAll("[data-photo-next]")] : [];

  if (carousel && slides.length > 1 && controls && counter && previous && nextButtons.length > 0) {
    let active = 0;
    let transitioning = false;
    const show = (index: number, direction = 1) => {
      if (transitioning) return;

      const next = (index + slides.length) % slides.length;
      if (next === active) return;

      transitioning = true;
      const outgoing = slides[active];
      const incoming = slides[next];
      const leave = direction > 0 ? "is-leaving-left" : "is-leaving-right";
      const enter = direction > 0 ? "is-entering-right" : "is-entering-left";

      outgoing.classList.remove("is-current");
      outgoing.classList.add(leave);
      outgoing.setAttribute("aria-hidden", "true");
      incoming.classList.remove("is-hidden");
      incoming.classList.add(enter);
      incoming.setAttribute("aria-hidden", "false");

      window.requestAnimationFrame(() => {
        incoming.classList.remove(enter);
        incoming.classList.add("is-current");
      });

      window.setTimeout(() => {
        outgoing.classList.remove(leave);
        outgoing.classList.add("is-hidden");
        outgoing.setAttribute("aria-hidden", "true");
        active = next;
        transitioning = false;
      }, 460);

      counter.textContent = `${String(next + 1).padStart(2, "0")} / ${String(slides.length).padStart(2, "0")}`;
    };
    previous.addEventListener("click", () => show(active - 1, -1));
    nextButtons.forEach((button) => button.addEventListener("click", () => show(active + 1)));
  } else if (controls) {
    controls.setAttribute("hidden", "true");
  }
</script>
