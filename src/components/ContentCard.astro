---
import TagList from "./TagList.astro";
import { formatDate, topicMeta, type ContentTopic } from "../lib/content";

interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  kind?: string;
  topic?: ContentTopic;
  cover?: string;
}

const { href, title, description, pubDate, tags = [], kind, topic, cover } = Astro.props;
---

<article class="content-card">
  <a class="content-card__link" href={href}>
    <div class="content-card__meta">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    </div>
    <div class="content-card__body">
      <h2>{title}</h2>
      <p>{description}</p>
    </div>
    <div class="content-card__aside">
      {cover && <img class="content-card__thumbnail" src={cover} alt="" loading="lazy" />}
      <span class="content-card__arrow" aria-hidden="true">↗</span>
    </div>
  </a>
  <div class="content-card__footer">
    <div class="content-card__topics">
      {(topic || kind) && <span class="content-card__topic">{topic && topicMeta[topic].label}{topic && kind && " / "}{kind}</span>}
      <TagList tags={tags} compact />
    </div>
    <span class="view-counter content-card__views" data-view-counter data-view-scope="article" data-view-resource={href} data-view-readonly="true" hidden>
      阅读 <strong data-view-count>0</strong>
    </span>
  </div>
</article>
