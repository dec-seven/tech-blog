---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
}

const siteTitle = "DecSeven";
const defaultDescription =
  "DecSeven 的个人网站：记录技术构建、生活观察、开源作品和暂时没有结论的奇怪想法。";
const { title = siteTitle, description = defaultDescription, article = false } = Astro.props;
const pageTitle = title === siteTitle ? siteTitle : `${title} | ${siteTitle}`;
const pathname = Astro.url.pathname;
const ogImage = new URL("/og.png", Astro.site ?? Astro.url).toString();

const navItems = [
  { href: "/work/", label: "作品" },
  { href: "/writing/", label: "写作" },
  { href: "/now/", label: "近况" },
  { href: "/about/", label: "关于" }
];

const isCurrent = (href: string) =>
  href === "/writing/"
    ? /^\/(writing|posts|notes|docs|tags)(\/|$)/.test(pathname)
    : pathname.startsWith(href);
const canonical = new URL(pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="DecSeven RSS" href="/rss.xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">跳到内容</a>
    <header class="site-header" data-pagefind-ignore>
      <a class="brand" href="/" aria-label="DecSeven 首页">
        <span class="brand-mark">D7</span>
        <span class="brand-name">DecSeven<span class="brand-dot">.</span></span>
      </a>
      <nav class="site-nav" aria-label="主导航">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
        <a class="nav-search" href="/search/" aria-current={pathname === "/search/" ? "page" : undefined}>
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg>
          <span>搜索</span>
        </a>
      </nav>
    </header>
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer" data-pagefind-ignore>
      <div>
        <p class="site-footer__statement">持续构建，慢慢记录。</p>
        <p>© {new Date().getFullYear()} DecSeven</p>
      </div>
      <div class="site-footer__links">
        <a href="https://github.com/dec-seven">GitHub ↗</a>
        <a href="/rss.xml">RSS ↗</a>
        <a href="#content">回到顶部 ↑</a>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const languageNames = {
          bash: "bash",
          sh: "shell",
          shell: "shell",
          text: "text",
          plaintext: "text",
          yaml: "yaml",
          yml: "yaml",
          ini: "ini",
          js: "js",
          ts: "ts",
          json: "json"
        };

        const getLanguage = (pre, code) => {
          const dataLanguage = pre.dataset.language;
          if (dataLanguage) return languageNames[dataLanguage] ?? dataLanguage;

          const languageClass = [...code.classList].find((className) =>
            className.startsWith("language-")
          );
          const key = languageClass?.replace("language-", "") ?? "";
          return languageNames[key] ?? key ?? "code";
        };

        const enhanceCodeBlocks = () => {
          document.querySelectorAll(".prose pre").forEach((pre) => {
            if (pre.parentElement?.classList.contains("code-shell")) return;

            const code = pre.querySelector("code");
            if (!code) return;

            const wrapper = document.createElement("div");
            wrapper.className = "code-shell";

            const bar = document.createElement("div");
            bar.className = "code-shell__bar";

            const label = document.createElement("span");
            label.className = "code-shell__lang";
            label.textContent = getLanguage(pre, code);

            const button = document.createElement("button");
            button.className = "code-shell__copy";
            button.type = "button";
            button.textContent = "复制";

            button.addEventListener("click", async () => {
              const text = code.innerText;
              try {
                await navigator.clipboard.writeText(text);
                button.textContent = "已复制";
              } catch {
                button.textContent = "手动复制";
              }
              window.setTimeout(() => {
                button.textContent = "复制";
              }, 1600);
            });

            bar.append(label, button);
            pre.parentNode?.insertBefore(wrapper, pre);
            wrapper.append(bar, pre);
          });
        };

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", enhanceCodeBlocks);
        } else {
          enhanceCodeBlocks();
        }
      })();
    </script>
  </body>
</html>
