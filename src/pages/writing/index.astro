---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WritingArchive from "../../components/WritingArchive.astro";
---
<BaseLayout title="文章" description="DecSeven 的技术文章、生活记录与奇想。按主题阅读，或按文章、笔记、资料筛选。">
  <header class="section writing-masthead">
    <div class="writing-masthead__title">
      <p class="eyebrow">WRITING / 技术 · 生活 · 奇想</p>
      <h1><span>文章，</span><span>也记录过程。</span></h1>
    </div>
    <p class="writing-masthead__lead">
      把做过的事写下来，也给尚未想明白的问题留一个位置。
    </p>
  </header>
  <WritingArchive />
</BaseLayout>
