---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WritingArchive from "../../components/WritingArchive.astro";
import { topicMeta, type ContentTopic } from "../../lib/content";
export function getStaticPaths() {
  return (Object.keys(topicMeta) as ContentTopic[]).map((topic) => ({ params: { topic }, props: { topic } }));
}
const { topic } = Astro.props;
const meta = topicMeta[topic];
---
<BaseLayout title={`文章 · ${meta.label}`} description={meta.description}>
  <header class="section page-heading page-heading--writing">
    <p class="eyebrow">文章 / {meta.label}</p>
    <h1>{meta.label}</h1>
    <p>{meta.description}</p>
  </header>
  <WritingArchive topic={topic} />
</BaseLayout>
