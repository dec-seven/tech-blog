---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProfilePanel from "../components/ProfilePanel.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ContentCard from "../components/ContentCard.astro";
import { getWriting, entryHref, collectionMeta, topicMeta } from "../lib/content";
import { visualNotes } from "../data/home";

const projects = (await getCollection("projects", ({ data }) => !data.draft && data.featured))
  .sort((a, b) => a.data.order - b.data.order);
const writing = await getWriting();
const selectedWriting = writing.filter(({ entry }) => entry.data.featured && entry.data.topic === "tech").slice(0, 3);
const asideWriting = writing.find(({ entry }) => entry.data.topic !== "tech");
---
<BaseLayout>
  <ProfilePanel />
  <section class="section home-section" aria-labelledby="work-title">
    <header class="section-heading">
      <div><p class="eyebrow">01 / SELECTED WORK</p><h2 id="work-title">做过的东西</h2></div>
      <a class="text-link" href="/work/">全部作品 <span aria-hidden="true">↗</span></a>
    </header>
    <div class="project-list">
      {projects.map((project, index) => <ProjectCard project={project} index={index + 1} />)}
    </div>
  </section>

  <section class="section visual-section" aria-labelledby="visual-title">
    <header class="section-heading">
      <div><p class="eyebrow">02 / VISUAL NOTES</p><h2 id="visual-title">把过程留下来。</h2></div>
      <p class="section-heading__aside">架构图、流程图和现场截图，记录那些不容易用一句话说清楚的部分。</p>
    </header>
    <div class="visual-grid">
      {visualNotes.map((note, index) => (
        <a class:list={["visual-note", index === 0 && "visual-note--wide"]} href={note.href}>
          <div class="visual-note__image">
            <img src={note.src} alt={note.alt} loading="lazy" />
          </div>
          <div class="visual-note__caption">
            <span class="eyebrow">{note.label}</span>
            <h3>{note.title}</h3>
            <span class="visual-note__arrow" aria-hidden="true">↗</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section home-section" aria-labelledby="writing-title">
    <header class="section-heading">
      <div><p class="eyebrow">03 / SELECTED WRITING</p><h2 id="writing-title">实践之后，写下来</h2></div>
      <a class="text-link" href="/writing/">全部写作 <span aria-hidden="true">↗</span></a>
    </header>
    <div class="content-list">
      {selectedWriting.map(({ entry, kind }) => (
        <ContentCard href={entryHref(kind, entry)} title={entry.data.title}
          description={entry.data.description} pubDate={entry.data.pubDate}
          tags={entry.data.tags} kind={collectionMeta[kind].label} topic={entry.data.topic} />
      ))}
    </div>
  </section>

  <section class="offscreen-band" aria-labelledby="outside-title">
    <div class="section outside-grid">
      <div>
        <p class="eyebrow">04 / BEYOND THE CODE</p>
        <h2 id="outside-title">屏幕之外，<br />还有很多值得记下。</h2>
        <p class="muted">生活不需要先变成经验，想法也不必急着有结论。</p>
        <div class="topic-links" aria-label="非技术写作">
          <a href="/writing/life/">生活 <span aria-hidden="true">↗</span></a>
          <a href="/writing/ideas/">奇想 <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      {asideWriting && (
        <article class="margin-note">
          <p class="eyebrow">{topicMeta[asideWriting.entry.data.topic].label} / NOTE</p>
          <h3><a href={entryHref(asideWriting.kind, asideWriting.entry)}>{asideWriting.entry.data.title}</a></h3>
          <p>{asideWriting.entry.data.description}</p>
          <a class="text-link" href={entryHref(asideWriting.kind, asideWriting.entry)}>读这条记录 <span aria-hidden="true">↗</span></a>
        </article>
      )}
    </div>
  </section>
</BaseLayout>
